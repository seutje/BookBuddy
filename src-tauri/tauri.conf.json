{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BookBuddy",
  "version": "0.1.2",
  "identifier": "local.bookbuddy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BookBuddy",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEQzdFMkU0MUY4Q0ZEN0QKUldSOS9Zd2Y1T0xIdlVEbjZ4MS9PNGFVWFJoc3FiamdiMWh0MEN0SGdUcE9FOEZkOFdGdVMxOEkK",
      "endpoints": [
        "https://github.com/seutje/BookBuddy/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
