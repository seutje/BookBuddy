{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window; no filesystem, shell, or network plugin access.",
  "windows": ["main"],
  "permissions": [
    "allow-startup-status",
    "allow-list-people",
    "allow-create-person",
    "allow-rename-person",
    "allow-archive-person",
    "allow-select-person",
    "allow-list-books",
    "allow-get-book",
    "allow-create-book",
    "allow-update-book",
    "allow-ensure-person-book",
    "allow-update-person-book",
    "allow-mark-read",
    "allow-duplicate-book-hints"
  ]
}
